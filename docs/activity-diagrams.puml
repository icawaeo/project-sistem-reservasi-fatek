' Activity diagrams for Sistem Reservasi FATEK
' Setiap blok @startuml ... @enduml dapat dirender terpisah di PlantUML.
' Diagram dibuat dengan swimlane dan memakai istilah yang mudah dipahami.

@startuml activity_register
title Registrasi Akun Pengguna
|Pengguna|
start
:Membuka halaman registrasi;
:Mengisi nama, email kampus, NIM/NIP, dan kata sandi;
:Mengirim formulir;
|Sistem|
:Memeriksa kelengkapan data;
if (Data lengkap?) then (Ya)
  :Memeriksa email kampus dan kata sandi;
  if (Data sesuai?) then (Ya)
    :Memastikan email belum terdaftar;
    if (Email belum dipakai?) then (Ya)
      :Menyimpan pendaftaran sementara;
      |Email|
      :Mengirim kode verifikasi;
      |Pengguna|
      :Memasukkan kode verifikasi;
      |Sistem|
      :Memeriksa kode verifikasi;
      if (Kode benar dan masih berlaku?) then (Ya)
        :Membuat akun pengguna;
        :Menghapus pendaftaran sementara;
        :Membuka sesi masuk;
        |Pengguna|
        :Masuk ke halaman utama;
      else (Tidak)
        |Pengguna|
        :Melihat pesan kode salah atau kedaluwarsa;
      endif
    else (Tidak)
      |Pengguna|
      :Melihat pesan email sudah terdaftar;
    endif
  else (Tidak)
    |Pengguna|
    :Memperbaiki email atau kata sandi;
  endif
else (Tidak)
  |Pengguna|
  :Melengkapi data yang kurang;
endif
stop
@enduml

@startuml activity_login
title Login dan Arah Halaman
|Pengguna|
start
:Membuka halaman login;
:Mengisi email dan kata sandi;
:Menekan tombol masuk;
|Sistem|
:Memeriksa akun dan kata sandi;
if (Akun valid?) then (Ya)
  :Membaca peran pengguna;
  if (Superadmin?) then (Ya)
    |Superadmin|
    :Masuk ke dashboard superadmin;
  elseif (Petugas?) then (Ya)
    |Petugas|
    :Masuk ke halaman administrator;
  else (Pengguna biasa)
    |Pengguna|
    :Masuk ke halaman utama;
  endif
else (Tidak)
  |Pengguna|
  :Melihat pesan email atau kata sandi salah;
endif
stop
@enduml

@startuml activity_set_password
title Membuat Kata Sandi untuk Akun Petugas
|Petugas|
start
:Membuka tautan dari email;
|Sistem|
:Memeriksa tautan undangan;
if (Tautan masih berlaku?) then (Ya)
  |Petugas|
  :Mengisi kata sandi baru;
  :Mengirim kata sandi;
  |Sistem|
  :Memeriksa kekuatan dan kecocokan kata sandi;
  if (Kata sandi sesuai?) then (Ya)
    :Menyimpan kata sandi baru;
    :Menandai undangan sudah dipakai;
    |Petugas|
    :Menuju halaman login;
  else (Tidak)
    |Petugas|
    :Memperbaiki kata sandi;
  endif
else (Tidak)
  |Petugas|
  :Melihat pesan tautan tidak berlaku;
endif
stop
@enduml

@startuml activity_check_availability
title Cek Ketersediaan Ruangan
|Pengguna|
start
:Membuka halaman utama;
:Memilih tanggal, jam, kapasitas, atau gedung;
:Menjalankan pencarian;
|Sistem|
:Mencari ruangan aktif;
:Membandingkan dengan jadwal peminjaman yang masih berlaku;
if (Ada ruangan kosong?) then (Ya)
  |Pengguna|
  :Melihat daftar ruangan tersedia;
  :Memilih ruangan yang cocok;
  |Sistem|
  :Menyiapkan pilihan ruangan;
  |Pengguna|
  :Menuju detail ruangan atau formulir reservasi;
else (Tidak)
  |Pengguna|
  :Melihat pesan tidak ada ruangan tersedia;
  :Mengubah pilihan pencarian;
endif
stop
@enduml

@startuml activity_view_building
title Melihat Gedung dan Ruangan
|Pengguna|
start
:Membuka daftar gedung;
:Memilih gedung;
|Sistem|
:Mengambil informasi gedung dan daftar ruangan;
if (Gedung aktif dan ditemukan?) then (Ya)
  |Pengguna|
  :Melihat informasi gedung;
  :Melihat daftar ruangan;
  if (Ingin meminjam ruangan?) then (Ya)
    :Memilih ruangan;
    |Sistem|
    :Menyimpan pilihan sementara;
    |Pengguna|
    :Menuju formulir reservasi;
  else (Tidak)
