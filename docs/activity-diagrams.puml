  endif
else (Tidak)
  |Pengguna|
  :Melihat pesan data tidak ditemukan;
endif
stop
@enduml

@startuml activity_create_reservation
title Mengajukan Reservasi Ruangan
|Pengguna|
start
:Membuka formulir reservasi;
:Memilih ruangan, tanggal, jam, dan tujuan;
if (Ruangan laboratorium?) then (Ya)
  :Memilih jenis kebutuhan lab;
  if (Butuh dokumen pendukung?) then (Ya)
    :Mengunggah dokumen pendukung;
  endif
else (Tidak)
  :Melanjutkan sebagai peminjaman umum;
endif
:Membuka halaman konfirmasi;
|Sistem|
:Memeriksa jadwal sekali lagi;
if (Jadwal masih kosong?) then (Ya)
  :Memeriksa apakah pengguna masih punya pengajuan aktif;
  if (Tidak ada pengajuan aktif?) then (Ya)
    :Memeriksa kelengkapan dan batas waktu pengajuan;
    if (Pengajuan memenuhi aturan?) then (Ya)
      :Menyimpan pengajuan;
      :Memberi status menunggu konfirmasi;
      |Notifikasi|
      :Memberi tahu petugas dan superadmin;
      |Pengguna|
      :Menuju halaman riwayat;
    else (Tidak)
      |Pengguna|
      :Melihat pesan aturan belum terpenuhi;
    endif
  else (Tidak)
    |Pengguna|
    :Melihat pesan masih ada pengajuan aktif;
  endif
else (Tidak)
  |Pengguna|
  :Memilih jadwal atau ruangan lain;
endif
stop
@enduml

