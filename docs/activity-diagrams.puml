|Notifikasi|
:Memberi tahu Dekan;
|Dekan|
:Memeriksa pengajuan;
if (Dekan menyetujui?) then (Ya)
  |Sistem|
  :Meneruskan pengajuan ke Wakil Dekan 2;
  |Notifikasi|
  :Memberi tahu Wakil Dekan 2;
  |Wakil Dekan 2|
  :Menandatangani surat keputusan;
  |Sistem|
  :Memasukkan tanda tangan Dekan dan Wakil Dekan 2 ke surat;
  :Menetapkan pengajuan disetujui;
  |Notifikasi|
  :Memberi tahu pengguna bahwa pengajuan disetujui;
else (Tidak)
  |Sistem|
  :Menetapkan pengajuan ditolak Dekan;
  |Notifikasi|
  :Memberi tahu pengguna bahwa pengajuan ditolak;
endif
stop
@enduml

