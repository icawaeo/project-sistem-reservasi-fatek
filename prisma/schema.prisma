// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  engineType = "binary"
  // output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql" 
}

enum UserType {
  USER
  STAFF
}

enum UserRole {
  USER
  ADMIN
  ADMIN_DEKAN
  ADMIN_WD2
  KAJUR
  KEPALA_LAB
  SUPERADMIN
}

enum LabProgram {
  IT
  ELEKTRO
  ARSITEKTUR
  PWK
  SIPIL
  LINGKUNGAN
  MESIN
}

enum LabDepartment {
  ELEKTRO
  ARSITEKTUR
  SIPIL
  MESIN
}

enum ReservationFlow {
  GENERAL
  LAB_SKRIPSI
  LAB_LAINNYA
}

model User {
  user_id      String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  identifier   String?   // NIM/NIP - nullable for STAFF (admin) users
  userType     UserType
  role         UserRole  @default(USER)
  departmentScope LabDepartment?
  programScope    LabProgram?
  signatureUrl String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
   
  reservations Reservation[]
  passwordSetupTokens PasswordSetupToken[]
  emailChangeTokens EmailChangeToken[]
  fcmTokens FcmToken[]
  notifications Notification[]
}

model PasswordSetupToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@index([userId])
}

model EmailChangeToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  newEmail  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [user_id], onDelete: Cascade)

  @@index([userId])
  @@index([newEmail])
}

model PendingRegistration {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  identifier   String
  passwordHash String
  otpHash      String
  expiresAt    DateTime
  attempts     Int      @default(0)
  lastSentAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

model Room {
  room_id        String  @id @default(cuid())
  room_name      String
  room_building  String
  room_locDetail String
  room_capacity  Int
  room_imageUrl  String?
  room_isActive  Boolean @default(true)

  labProgram     LabProgram?
  labDepartment  LabDepartment?

  // Relasi: Satu ruangan bisa ada di banyak reservasi
  reservations Reservation[]
}

model Building {
  building_id      String   @id @default(cuid())
  building_name    String   @unique
  operational_days String[]
  open_time        String
  close_time       String
  building_imageUrl String?
  building_isActive Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Facility {
  fac_id   String @id @default(cuid())
  fac_name String
  fac_qty  Int

  // Relasi: Satu fasilitas bisa dipesan di banyak item reservasi
  reservation_items ReservationItem[]
}

model Reservation {
  res_id          String   @id @default(cuid())
  res_date        DateTime @default(now())
  res_startTime   DateTime
  res_endTime     DateTime
  res_purpose     String
  res_flow        ReservationFlow @default(GENERAL)
  res_status      String   @default("PENDING") // e.g., "PENDING", "APPROVED", "REJECTED"
  res_documentUrl String?

  res_labProgram    LabProgram?
  res_labDepartment LabDepartment?

  // Tracking Admin/System processing
  res_processedBy String?
  res_processedAt DateTime?

  // Per-step progress timestamps
  res_waitingDekanAt DateTime?
  res_waitingWd2At   DateTime?
  res_waitingKajurAt DateTime?
  res_waitingKepalaLabAt DateTime?
  res_decisionAt     DateTime?

  // Foreign Keys
  user_id String
  user    User   @relation(fields: [user_id], references: [user_id])

  room_id String
  room    Room   @relation(fields: [room_id], references: [room_id])

  // Relasi: Satu reservasi bisa meminjam banyak fasilitas tambahan
  reservation_items ReservationItem[]
}

model ReservationItem {
  // Primary key gabungan atau ID unik
  id String @id @default(cuid())
  
  res_id      String
  reservation Reservation @relation(fields: [res_id], references: [res_id])
  
  fac_id   String
  facility Facility @relation(fields: [fac_id], references: [fac_id])
  
  resItem_qty Int
}

// NEW MODELS FOR FCM AND NOTIFICATIONS

model FcmToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId])
}

model Notification {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [user_id], onDelete: Cascade)
  title         String
  body          String
  data          Json     // For custom data like reservationId, type, etc.
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  @@index([userId])
  @@index([userId, isRead])
}